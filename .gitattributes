portable_config/shaders/ArtCNN*.glsl filter=lfs diff=lfs merge=lfs -text
portable_config/shaders/CfL*.glsl filter=lfs diff=lfs merge=lfs -text
portable_config/shaders/nlmeans*.glsl filter=lfs diff=lfs merge=lfs -text
portable_config/shaders/ravu*.hook filter=lfs diff=lfs merge=lfs -text

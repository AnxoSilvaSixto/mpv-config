# LFS: large shaders only. hdr-toys + SSim stay plain text.
* text=auto eol=lf
portable_config/shaders/ArtCNN*.glsl filter=lfs diff=lfs merge=lfs -text
portable_config/shaders/CfL*.glsl filter=lfs diff=lfs merge=lfs -text
portable_config/shaders/nlmeans*.glsl filter=lfs diff=lfs merge=lfs -text
portable_config/shaders/ravu*.hook filter=lfs diff=lfs merge=lfs -text
portable_config/shaders/SSim*.glsl !filter !diff !merge text
portable_config/shaders/KrigBilateral.glsl !filter !diff !merge text
portable_config/shaders/FSRCNNX*.glsl !filter !diff !merge text
portable_config/shaders/hdeband.glsl !filter !diff !merge text
portable_config/shaders/noise_static*.hook !filter !diff !merge text
updater.bat text eol=crlf
